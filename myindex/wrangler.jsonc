{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myvita",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myvita",
      "database_id": "422f075c-c26c-4f65-b275-f2e4e8b6e959",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    // Öffentliche Adresse, für Links in E-Mails. Nach dem Kauf der Domain hier ändern.
    "APP_URL": "https://myvita.workers.dev"
  }
  // RESEND_API_KEY für E-Mails als Secret im Cloudflare-Dashboard setzen, nicht hier.
}
