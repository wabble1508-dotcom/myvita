{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myvita",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myvita",
      "database_id": "422f075c-c26c-4f65-b275-f2e4e8b6e959",
      "migrations_dir": "drizzle"
    }
  ]
  // Optional: "vars": { "APP_URL": "https://deine-domain.de" } – sonst nimmt die App die Adresse der Anfrage.
  // RESEND_API_KEY für E-Mails als Secret im Cloudflare-Dashboard setzen, nicht hier.
}
